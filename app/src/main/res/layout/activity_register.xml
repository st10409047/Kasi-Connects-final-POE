<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FC">

    <!-- HEADER -->
    <View
        android:id="@+id/registerHeader"
        android:layout_width="0dp"
        android:layout_height="165dp"
        android:background="#102A56"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- BRANDING -->
    <TextView
        android:id="@+id/txtRegisterBrand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:text="KasiConnect"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- HEADING -->
    <TextView
        android:id="@+id/txtRegisterHeading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:text="Create Your Account"
        android:textColor="#FFFFFF"
        android:textSize="23sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/txtRegisterBrand"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- SUBHEADING -->
    <TextView
        android:id="@+id/txtRegisterDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Join your community with KasiConnect."
        android:textColor="#DCE8FA"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/txtRegisterHeading"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- REGISTRATION SCROLL VIEW -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="20dp"
        app:layout_constraintTop_toBottomOf="@id/registerHeader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="5dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp">

                <!-- FORM TITLE -->
                <TextView
                    android:id="@+id/txtFormTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Personal Information"
                    android:textColor="#102A56"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>

                <!-- FULL NAME -->
                <TextView
                    android:id="@+id/txtFullNameLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Full Name"
                    android:textColor="#25344A"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/txtFormTitle"
                    app:layout_constraintStart_toStartOf="parent"/>

                <EditText
                    android:id="@+id/edtFullName"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginTop="7dp"
                    android:background="@android:drawable/edit_text"
                    android:hint="Enter your full name"
                    android:inputType="textPersonName"
                    android:padding="12dp"
                    android:textSize="14sp"
                    app:layout_constraintTop_toBottomOf="@id/txtFullNameLabel"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <!-- EMAIL -->
                <TextView
                    android:id="@+id/txtRegisterEmailLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Email Address"
                    android:textColor="#25344A"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/edtFullName"
                    app:layout_constraintStart_toStartOf="parent"/>

                <EditText
                    android:id="@+id/edtRegisterEmail"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginTop="7dp"
                    android:background="@android:drawable/edit_text"
                    android:hint="Enter your email address"
                    android:inputType="textEmailAddress"
                    android:padding="12dp"
                    android:textSize="14sp"
                    app:layout_constraintTop_toBottomOf="@id/txtRegisterEmailLabel"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <!-- PHONE NUMBER -->
                <TextView
                    android:id="@+id/txtPhoneLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Phone Number"
                    android:textColor="#25344A"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/edtRegisterEmail"
                    app:layout_constraintStart_toStartOf="parent"/>

                <EditText
                    android:id="@+id/edtPhone"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginTop="7dp"
                    android:background="@android:drawable/edit_text"
                    android:hint="Enter phone number"
                    android:inputType="phone"
                    android:padding="12dp"
                    android:textSize="14sp"
                    app:layout_constraintTop_toBottomOf="@id/txtPhoneLabel"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <!-- LOCATION -->
                <TextView
                    android:id="@+id/txtLocationLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Community / Location"
                    android:textColor="#25344A"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/edtPhone"
                    app:layout_constraintStart_toStartOf="parent"/>

                <EditText
                    android:id="@+id/edtLocation"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginTop="7dp"
                    android:background="@android:drawable/edit_text"
                    android:hint="e.g. Umlazi, Durban"
                    android:inputType="textCapWords"
                    android:padding="12dp"
                    android:textSize="14sp"
                    app:layout_constraintTop_toBottomOf="@id/txtLocationLabel"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <!-- PASSWORD -->
                <TextView
                    android:id="@+id/txtRegisterPasswordLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Password"
                    android:textColor="#25344A"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/edtLocation"
                    app:layout_constraintStart_toStartOf="parent"/>

                <EditText
                    android:id="@+id/edtRegisterPassword"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginTop="7dp"
                    android:background="@android:drawable/edit_text"
                    android:hint="Create a password"
                    android:inputType="textPassword"
                    android:padding="12dp"
                    android:textSize="14sp"
                    app:layout_constraintTop_toBottomOf="@id/txtRegisterPasswordLabel"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <!-- CONFIRM PASSWORD -->
                <TextView
                    android:id="@+id/txtConfirmPasswordLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Confirm Password"
                    android:textColor="#25344A"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/edtRegisterPassword"
                    app:layout_constraintStart_toStartOf="parent"/>

                <EditText
                    android:id="@+id/edtConfirmPassword"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginTop="7dp"
                    android:background="@android:drawable/edit_text"
                    android:hint="Confirm your password"
                    android:inputType="textPassword"
                    android:padding="12dp"
                    android:textSize="14sp"
                    app:layout_constraintTop_toBottomOf="@id/txtConfirmPasswordLabel"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <!-- REGISTER BUTTON -->
                <Button
                    android:id="@+id/btnRegister"
                    android:layout_width="0dp"
                    android:layout_height="55dp"
                    android:layout_marginTop="25dp"
                    android:backgroundTint="#16A6A1"
                    android:text="CREATE ACCOUNT"
                    android:textAllCaps="true"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/edtConfirmPassword"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <!-- LOGIN REDIRECT -->
                <TextView
                    android:id="@+id/txtAlreadyHaveAccount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:layout_marginBottom="8dp"
                    android:text="Already have an account? Login"
                    android:textColor="#102A56"
                    android:textSize="14sp"
                    app:layout_constraintTop_toBottomOf="@id/btnRegister"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>