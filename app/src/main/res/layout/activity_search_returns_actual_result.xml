
<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F5F9">

    <!-- HEADER -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/searchHeader"
        android:layout_width="0dp"
        android:layout_height="145dp"
        android:background="#142746"
        android:padding="18dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/txtAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="KasiConnect"
            android:textColor="#FFFFFF"
            android:textSize="25sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/txtSearchSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Discover opportunities around you"
            android:textColor="#DCE6F5"
            android:textSize="14sp"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/txtAppName"
            app:layout_constraintStart_toStartOf="parent"/>

        <ImageButton
            android:id="@+id/btnNotifications"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:src="@android:drawable/ic_popup_reminder"
            android:background="@android:color/transparent"
            android:contentDescription="Notifications"
            app:tint="#FFFFFF"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>


    <!-- SEARCH AREA -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/searchArea"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:background="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/searchHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- SEARCH TEXT FIELD -->
        <EditText
            android:id="@+id/edtSearch"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:hint="Search businesses, jobs, products..."
            android:singleLine="true"
            android:inputType="text"
            android:paddingStart="15dp"
            android:paddingEnd="12dp"
            android:textColor="#142746"
            android:textColorHint="#8994A5"
            android:backgroundTint="#245A87"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnSearch"
            app:layout_constraintHorizontal_weight="1"/>

        <!-- SEARCH BUTTON -->
        <Button
            android:id="@+id/btnSearch"
            android:layout_width="105dp"
            android:layout_height="55dp"
            android:text="SEARCH"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#142746"
            android:layout_marginStart="8dp"
            app:layout_constraintTop_toTopOf="@id/edtSearch"
            app:layout_constraintBottom_toBottomOf="@id/edtSearch"
            app:layout_constraintStart_toEndOf="@id/edtSearch"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- CLEAR SEARCH -->
        <TextView
            android:id="@+id/btnClearSearch"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Clear search"
            android:textColor="#245A87"
            android:gravity="center"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintTop_toBottomOf="@id/edtSearch"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- CATEGORY LABEL -->
        <TextView
            android:id="@+id/txtCategoryLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Search category"
            android:textColor="#142746"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="5dp"
            app:layout_constraintTop_toBottomOf="@id/btnClearSearch"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- CATEGORY SPINNER -->
        <Spinner
            android:id="@+id/spinnerSearchCategory"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:backgroundTint="#245A87"
            android:entries="@array/search_categories"
            android:layout_marginTop="5dp"
            app:layout_constraintTop_toBottomOf="@id/txtCategoryLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>


    <!-- RESULT HEADER -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/resultHeader"
        android:layout_width="0dp"
        android:layout_height="65dp"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        app:layout_constraintTop_toBottomOf="@id/searchArea"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/txtResultsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Search Results"
            android:textColor="#142746"
            android:textSize="19sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/txtResultCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 results"
            android:textColor="#687386"
            android:textSize="13sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>


    <!-- RESULTS LIST -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerSearchResults"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="15dp"
        android:paddingEnd="15dp"
        android:paddingTop="5dp"
        android:paddingBottom="15dp"
        android:visibility="visible"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintTop_toBottomOf="@id/resultHeader"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


    <!-- LOADING INDICATOR -->
    <ProgressBar
        android:id="@+id/progressSearch"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/recyclerSearchResults"
        app:layout_constraintBottom_toBottomOf="@id/recyclerSearchResults"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


    <!-- EMPTY RESULTS MESSAGE -->
    <LinearLayout
        android:id="@+id/layoutNoResults"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="25dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/recyclerSearchResults"
        app:layout_constraintBottom_toBottomOf="@id/recyclerSearchResults"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="75dp"
            android:layout_height="75dp"
            android:src="@android:drawable/ic_menu_search"
            android:contentDescription="No search results"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No results found"
            android:textColor="#142746"
            android:textSize="19sp"
            android:textStyle="bold"
            android:layout_marginTop="15dp"/>

        <TextView
            android:id="@+id/txtNoResultsDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Try another keyword or select a different category."
            android:textColor="#687386"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="8dp"/>

    </LinearLayout>


    <!-- ERROR MESSAGE -->
    <TextView
        android:id="@+id/txtSearchError"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Unable to load results. Check your internet connection."
        android:textColor="#B3261E"
        android:textSize="14sp"
        android:gravity="center"
        android:padding="15dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/recyclerSearchResults"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


    <!-- BOTTOM NAVIGATION -->
    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="65dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#142746"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Home"
            android:textColor="#FFFFFF"
            android:textSize="11sp"/>

        <TextView
            android:id="@+id/navBusiness"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Business"
            android:textColor="#F5B942"
            android:textStyle="bold"
            android:textSize="11sp"/>

        <TextView
            android:id="@+id/navJobs"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Jobs"
            android:textColor="#FFFFFF"
            android:textSize="11sp"/>

        <TextView
            android:id="@+id/navMarket"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Market"
            android:textColor="#FFFFFF"
            android:textSize="11sp"/>

        <TextView
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Profile"
            android:textColor="#FFFFFF"
            android:textSize="11sp"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
