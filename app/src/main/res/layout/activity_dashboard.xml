<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6FA">

    <TextView
        android:id="@+id/txtDashboardHeader"
        android:layout_width="match_parent"
        android:layout_height="155dp"
        android:background="#142746"
        android:padding="22dp"
        android:gravity="center_vertical"
        android:text="KasiConnect\nWelcome to your community!"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"/>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/txtDashboardHeader"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Explore KasiConnect"
                android:textSize="21sp"
                android:textStyle="bold"
                android:textColor="#142746"
                android:paddingBottom="12dp"/>

            <Button
                android:id="@+id/cardLocalBusinesses"
                android:layout_width="match_parent"
                android:layout_height="75dp"
                android:text="LOCAL BUSINESSES"
                android:backgroundTint="#142746"/>

            <Button
                android:id="@+id/cardJobs"
                android:layout_width="match_parent"
                android:layout_height="75dp"
                android:text="JOBS & OPPORTUNITIES"
                android:backgroundTint="#245A87"
                android:layout_marginTop="12dp"/>

            <Button
                android:id="@+id/cardMarketplace"
                android:layout_width="match_parent"
                android:layout_height="75dp"
                android:text="MARKETPLACE"
                android:backgroundTint="#F5B942"
                android:textColor="#142746"
                android:layout_marginTop="12dp"/>

            <Button
                android:id="@+id/cardApplications"
                android:layout_width="match_parent"
                android:layout_height="75dp"
                android:text="MY APPLICATIONS"
                android:backgroundTint="#245A87"
                android:layout_marginTop="12dp"/>

            <Button
                android:id="@+id/cardProfile"
                android:layout_width="match_parent"
                android:layout_height="75dp"
                android:text="MY PROFILE"
                android:backgroundTint="#142746"
                android:layout_marginTop="12dp"/>

            <Button
                android:id="@+id/cardSettings"
                android:layout_width="match_parent"
                android:layout_height="75dp"
                android:text="SETTINGS"
                android:backgroundTint="#245A87"
                android:layout_marginTop="12dp"/>

            <Button
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:text="LOG OUT"
                android:backgroundTint="#B3261E"
                android:layout_marginTop="20dp"/>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#142746"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Home"
            android:textColor="#FFFFFF"/>

        <TextView
            android:id="@+id/navBusiness"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Business"
            android:textColor="#FFFFFF"/>

        <TextView
            android:id="@+id/navJobs"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Jobs"
            android:textColor="#FFFFFF"/>

        <TextView
            android:id="@+id/navMarket"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Market"
            android:textColor="#FFFFFF"/>

        <TextView
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Profile"
            android:textColor="#FFFFFF"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>